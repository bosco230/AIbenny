# Copy to web/.env on the server and fill in. Never commit .env.

# Passcode visitors type to enter (share it with your friends), 6+ characters.
WEB_PASSCODE=

# 32+ random characters for signing login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-haiku-5.5
HELPER_MODEL=qwen/qwen3.7-flash

# Azure Speech (Cantonese voice in/out). Leave empty for text-only chat.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast

# Web address. Free option: the VPS IP with dashes + .sslip.io,
# e.g. IP 5.75.1.2 -> SITE_ADDRESS=5-75-1-2.sslip.io  (Caddy adds HTTPS).
SITE_ADDRESS=

# Optional, only with your own domain + Cloudflare Tunnel
# (docker compose --profile cloudflare up -d). Service: http://web:8080
CLOUDFLARE_TUNNEL_TOKEN=

# Usage limits (protect your bills).
LIMIT_MESSAGES_PER_10MIN=30
LIMIT_MESSAGES_PER_DAY=300
LIMIT_TTS_CHARS_PER_DAY=6000
LIMIT_TTS_CHARS_PER_DAY_TOTAL=60000
LIMIT_STT_PER_DAY=200
